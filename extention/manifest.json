{
  "manifest_version": 3,
  "name": "YouTube Music Rich Presence",
  "version": "2.2.1",
  "description": "Displays your YouTube Music playback on Discord Rich Presence and synchronizes music in real time with friends via Listen Together.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://fishyspop.github.io/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fishyspop.github.io/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fishyspop.github.io/*"
      ],
      "js": [
        "gateway-interceptor.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "early-url-capture.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "log-forwarder.js",
        "webrtc-sync.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Music RPC Status",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
