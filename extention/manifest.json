{
  "manifest_version": 3,
  "name": "YouTube Music Rich Presence",
  "version": "2.0",
  "description": "Displays your current YouTube Music activity on Discord and Listen along via a native helper application.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://fishyspop.github.io/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fishyspop.github.io/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fishyspop.github.io/*"],
      "js": ["gateway-interceptor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["early-url-capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["log-forwarder.js", "webrtc-sync.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Music RPC Status"
  }
}